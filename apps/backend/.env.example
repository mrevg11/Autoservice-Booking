# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=autoservice
DB_USER=autoservice_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
DB_SYNC=false

# JWT
JWT_SECRET=change-me-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=change-me-super-secret-refresh-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:5173

# Email (dev: Mailtrap)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_mailtrap_user
MAIL_PASS=your_mailtrap_pass
MAIL_FROM=noreply@autoservice.local

# Intelligence weights
SCORE_WEIGHT_RATING=0.35
SCORE_WEIGHT_AVAILABILITY=0.25
SCORE_WEIGHT_EXPERIENCE=0.20
SCORE_WEIGHT_LOAD=0.10
SCORE_WEIGHT_SPECIALIZATION=0.10
